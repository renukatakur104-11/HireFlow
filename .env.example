# ==========================================
# HireFlow Environment Configuration Template
# ==========================================
# Copy this file to .env and provide your actual secrets.
# NEVER commit the actual .env file to version control.

# ------------------------------------------
# 1. AIVEN CLOUD MYSQL CONFIGURATION (PRIMARY)
# ------------------------------------------
# Format: jdbc:mysql://<aiven-host>:<port>/<dbname>?sslMode=REQUIRED&allowPublicKeyRetrieval=true&useSSL=true&serverTimezone=UTC
DB_URL=jdbc:mysql://mysql-hireflow-your-project.aivencloud.com:12345/defaultdb?sslMode=REQUIRED&allowPublicKeyRetrieval=true&useSSL=true&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here

# ------------------------------------------
# 2. SECURITY & JWT CONFIGURATION
# ------------------------------------------
# Secure 256-bit+ secret key for HMAC-SHA256 signing
JWT_SECRET=your_super_secret_jwt_key_should_be_at_least_32_characters_long_256bit
# 15 minutes in milliseconds
JWT_EXPIRATION_MS=900000
# 7 days in milliseconds
REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------
# 3. INITIAL ADMIN BOOTSTRAP CREDENTIALS
# ------------------------------------------
# Used on startup only if no admin account exists in database
ADMIN_BOOTSTRAP_EMAIL=admin@hireflow.edu
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword123!

# ------------------------------------------
# 4. AI ADVISORY MODULE CONFIGURATION
# ------------------------------------------
# Provider: GEMINI | OPENAI
AI_PROVIDER=GEMINI
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# ------------------------------------------
# 5. NETWORKING & CORS
# ------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80

# ------------------------------------------
# 6. STORAGE & UPLOADS
# ------------------------------------------
UPLOAD_DIR=./uploads/resumes
MAX_RESUME_SIZE_MB=5

# ------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------
# 8. OPTIONAL SMTP CONFIGURATION (GRACEFUL FALLBACK)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
